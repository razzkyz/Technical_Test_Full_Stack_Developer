generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password")
  role         UserRole
  createdAt    DateTime @default(now()) @map("createdAt")

  @@index([username])
  @@map("User")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(20)
  address   String
  createdAt DateTime @default(now()) @map("createdAt")
  orders    Order[]

  @@index([name])
  @@map("Customer")
}

model Product {
  id         String      @id @db.VarChar(50)
  code       String      @unique @db.VarChar(50)
  name       String      @db.VarChar(100)
  type       String      @db.VarChar(50)
  color      String      @db.VarChar(50)
  size       String      @db.VarChar(20)
  createdAt  DateTime    @default(now()) @map("createdAt")
  orderItems OrderItem[]

  @@index([code])
  @@index([type])
  @@map("Product")
}

model Order {
  id          Int             @id @default(autoincrement())
  orderNumber String          @unique @map("orderNumber") @db.VarChar(50)
  customerId  Int             @map("customerId")
  orderDate   DateTime        @map("orderDate") @db.Date
  deadline    DateTime        @db.Date
  status      ProductionStage @default(NOT_PROCESSED)
  createdAt   DateTime        @default(now()) @map("createdAt")
  items       OrderItem[]
  customer    Customer        @relation(fields: [customerId], references: [id])

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([deadline])
  @@map("Order")
}

model OrderItem {
  id                 Int                  @id @default(autoincrement())
  orderId            Int                  @map("orderId")
  productId          String               @map("productId") @db.VarChar(50)
  quantity           Int
  currentStage       ProductionStage      @default(NOT_PROCESSED) @map("currentStage")
  createdAt          DateTime             @default(now()) @map("createdAt")
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id])
  productionProgress ProductionProgress[]
  rejectRecords      RejectRecord[]

  @@index([orderId])
  @@index([productId])
  @@index([currentStage])
  @@map("OrderItem")
}

model ProductionProgress {
  id          Int             @id @default(autoincrement())
  orderItemId Int             @map("orderItemId")
  stage       ProductionStage
  quantity    Int
  timestamp   DateTime        @default(now())
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([stage])
  @@index([timestamp])
  @@map("ProductionProgress")
}

model RejectRecord {
  id                Int             @id @default(autoincrement())
  orderItemId       Int             @map("orderItemId")
  rejectedQuantity  Int
  reason            String?
  timestamp         DateTime        @default(now())
  orderItem         OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([timestamp])
  @@map("RejectRecord")
}

enum UserRole {
  ADMIN
  PRODUCTION
}

enum ProductionStage {
  NOT_PROCESSED
  CUTTING
  SEWING
  QC
  FINISHING
  PACKING
  COMPLETE
}
